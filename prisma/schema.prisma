// Modelo de dados — ver docs/Planejamento-Plataforma-CFTV.md, seção 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CameraStatus {
  PLANNED // planejada, ainda não instalada
  ACTIVE // instalada e em operação
  INACTIVE // instalada mas fora de operação
  MAINTENANCE
}

enum LensType {
  FIXED // uma distância focal só
  VARIFOCAL // lente varifocal manual/motorizada (ex: 2.8-12mm)
  MOTORIZED_ZOOM // PTZ/speed dome com zoom óptico grande
}

/// Catálogo de modelos de câmera (fabricante/modelo), com specs ópticos extraídos do datasheet
/// do fabricante. Importado a partir do device type library do NetBox + pesquisa manual/web.
/// Serve para autopreencher os defaults de fovAngle/rangeMeters ao cadastrar uma Camera.
model CameraModel {
  id String @id @default(cuid())

  manufacturer String
  model        String
  slug         String @unique // slug do device type no NetBox

  lensType         LensType? // null quando o modelo não pôde ser identificado com confiança (ver notes)
  focalLengthMinMm Float?
  focalLengthMaxMm Float?

  fovHorizontalMaxDeg Float? // FOV na abertura mais larga (foco mínimo), em graus
  fovHorizontalMinDeg Float? // FOV no zoom máximo (foco máximo), em graus — null se lente fixa

  resolutionMp  Float?
  irRangeMeters Float? // alcance máximo de IR do datasheet — usado como default de rangeMeters

  datasheetUrl String?
  notes        String? // ex: variante de lente assumida quando o modelo tem mais de uma opção

  cameras Camera[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uma câmera posicionada na planta (espaço em metros, calibrado a partir da imagem de fundo — Opção A do planejamento).
model Camera {
  id String @id @default(cuid())

  code String @unique // código/tag interno (ex: patrimônio GLPI, se importado)
  name String

  cameraModel   CameraModel? @relation(fields: [cameraModelId], references: [id])
  cameraModelId String?

  // Posição em metros, relativa à origem calibrada da imagem de fundo (ver BackgroundMap.scaleMetersPerPixel)
  positionX Float
  positionY Float

  installHeight Float? // altura de instalação, em metros
  azimuth       Float // direção para onde a câmera aponta, em graus (0-360, 0 = norte da planta)
  fovAngle      Float // abertura horizontal da lente, em graus — default vem de cameraModel, editável por câmera
  rangeMeters   Float // alcance máximo considerado para o cone de FOV, em metros — default vem de cameraModel, editável por câmera

  status CameraStatus @default(PLANNED)

  // Integração futura com NVR/VMS (Fase 4) — opcional desde o início, ver seção 5 do planejamento.
  streamUrl  String?
  channelRef String?

  photoUrl String?
  notes    String? // usado também para guardar a localização "crua" do NetBox até a posição ser calibrada no canvas

  glpiAssetId String? // referência ao ativo no GLPI, se a câmera foi importada de lá

  coverageZone CoverageZone?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([cameraModelId])
}

/// Segmento de linha (parede, pilar, muro) usado para recortar o cone de visibilidade das câmeras (Fase 2).
model Obstacle {
  id String @id @default(cuid())

  label String?

  // Segmento de linha em metros, mesmo referencial das câmeras.
  startX Float
  startY Float
  endX   Float
  endY   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Polígono de FOV já recortado pelos obstáculos — cache do resultado do visibility-polygon,
/// recalculado quando a câmera ou algum obstáculo muda (Fase 2).
model CoverageZone {
  id String @id @default(cuid())

  camera   Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  cameraId String @unique

  /// Pontos do polígono já recortado, em metros: [{ "x": number, "y": number }, ...]
  polygon Json

  areaSquareMeters Float?

  computedAt DateTime @updatedAt
}

/// Cor de destaque do cone de alcance das câmeras ativas no mapa. Não existe tabela de usuários
/// (autenticação é via AD, sem persistir linha no banco — ver src/lib/session.ts) então a linha é
/// identificada pelo username do AD; a linha global (definida por um admin, vale pra quem nunca
/// escolheu cor própria) usa o username sentinela "__global__". Prioridade de leitura: pessoal >
/// global > padrão fixo no frontend (ver src/lib/colors.ts).
model RangeColorSetting {
  id String @id @default(cuid())

  username String @unique // "__global__" = padrão definido por um admin; senão, sAMAccountName do AD
  color    String // hex de 6 dígitos, ex: "#22c55e"

  updatedAt DateTime @updatedAt
}

/// Ponto de restauração: snapshot completo de Camera + CameraModel + BackgroundMap tirado logo
/// antes de uma alteração administrativa (criar/mover/editar/remover câmera, trocar/calibrar mapa
/// de fundo, editar defaults de modelo). Criado no máximo 1x a cada ~10s por ação em sequência (ver
/// src/lib/checkpoint.ts) pra não virar um registro por campo editado. Obstacle/CoverageZone (Fase
/// 2, ainda sem uso) ficam de fora por enquanto — e RangeColorSetting fica de fora de propósito, é
/// preferência pessoal/estética, não dado do projeto.
model Checkpoint {
  id String @id @default(cuid())

  label    String // descrição curta e legível da ação que estava prestes a acontecer
  username String // quem disparou a ação que gerou o checkpoint

  /// Estado completo antes da ação: { cameras: Camera[], cameraModels: CameraModel[], backgroundMaps: BackgroundMap[] }
  snapshot Json

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Metadados da imagem de fundo (planta/imagem de drone) e sua calibração metro↔pixel.
model BackgroundMap {
  id String @id @default(cuid())

  name     String
  imageUrl String

  widthPx  Int
  heightPx Int

  // Calibração: distância real (metros) correspondente à distância entre dois pontos clicados na imagem (pixels).
  scaleMetersPerPixel Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}
