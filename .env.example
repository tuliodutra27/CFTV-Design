# Postgres — usado pelo docker-compose (serviço "db") e pelo Prisma
POSTGRES_USER=cftv
POSTGRES_PASSWORD=cftv
POSTGRES_DB=cftv_design

# String de conexão usada pelo Prisma dentro do container "app"
# (host "db" é o nome do serviço no docker-compose, não localhost)
DATABASE_URL="postgresql://cftv:cftv@db:5432/cftv_design?schema=public"

# ── Sessão (login) ───────────────────────────────────────────────────────
# Chave usada pra assinar o cookie de sessão. Gere uma com:
#   openssl rand -hex 32
SESSION_SECRET=troque-por-uma-chave-segura-gerada-aleatoriamente

# ── Active Directory ──────────────────────────────────────────────────────
# Mesmo esquema do Indicadores-RH (github.com/tuliodutra27/Indicadores-RH).
#
# Endereço do servidor LDAP/AD (IP ou hostname, com ou sem "ldap://")
AD_SERVER=ldap://192.168.1.10

# Porta LDAP (389 = padrão, 636 = LDAPS)
AD_PORT=389

# Usar SSL/LDAPS? (true/false)
AD_USE_SSL=false

# Domínio AD — usado para montar o UPN de login (usuario@DOMINIO)
AD_DOMAIN=aliseo.local

# Base DN para pesquisa no AD
AD_BASE_DN=DC=aliseo,DC=local

# Grupos do AD com permissão de EDITAR (perfil Administrador) — aceita nome puro, "CN=nome"
# ou DN completo; separe múltiplos grupos com ";".
AD_ADMIN_GROUP_CN=GRP_CFTV_ADMIN

# Grupos do AD com permissão de só VISUALIZAR (perfil Operador) — mesmo formato acima.
# Quem estiver nos dois grupos vira Administrador (o mais permissivo vence).
AD_OPERATOR_GROUP_CN=GRP_CFTV_OPERADOR

# ── Modo desenvolvimento (DESABILITAR em produção!) ────────────────────────
# Permite login sem AD para testes locais.
DEV_MODE=false

# Usuários de teste no formato JSON "usuario": "senha:perfil" (perfil = admin ou operator).
# Sem ":perfil", vira operator. Só funciona com DEV_MODE=true.
# DEV_USERS={"admin":"senha123:admin","operador":"senha123:operator"}
DEV_USERS={}
